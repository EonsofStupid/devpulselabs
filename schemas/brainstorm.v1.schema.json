{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devpulselabs:schemas:brainstorm:v1",
  "title": "DevPULSE brainstorm board (v1)",
  "description": "The wire contract for dpl-workflows BrainstormDoc v1 - the chat-triggered brainstorm board: the seed idea, its phased breakdown (diverge/cluster/converge), items with breakdown parentage and disclosed origin (operator vs assist), and named clusters. Strict: unknown fields are drift. The Rust shape and this schema are pinned together by test. v2 will sit BESIDE this file, never replace it (docs/design/workflow-doctrine.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "template", "phase"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "#/$defs/kebab" },
    "template": { "$ref": "#/$defs/kebab" },
    "seed": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["diverge", "cluster", "converge"] },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "clusters": {
      "type": "array",
      "items": { "$ref": "#/$defs/cluster" }
    }
  },
  "$defs": {
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "origin"],
      "properties": {
        "id": { "$ref": "#/$defs/kebab" },
        "text": { "type": "string", "minLength": 1 },
        "parent": { "$ref": "#/$defs/kebab" },
        "cluster": { "$ref": "#/$defs/kebab" },
        "origin": { "enum": ["operator", "assist"] }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/kebab" },
        "label": { "type": "string", "minLength": 1 }
      }
    }
  }
}
