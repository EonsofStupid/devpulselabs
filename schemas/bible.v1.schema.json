{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:devpulselabs:schemas:bible:v1",
  "title": "DevPULSE bible document (v1)",
  "description": "The wire contract for dpl-workflows BibleDoc v1 - the production+script bible minted from a guided intake: canon (subject/audience/tone/style/constraints), the format axis, and the script half (per-beat narration; no silent beats). Strict: unknown fields are drift. The Rust shape and this schema are pinned together by test. v2 will sit BESIDE this file, never replace it (docs/design/workflow-doctrine.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "id", "workflow", "subject", "audience", "tone", "format", "beats"],
  "properties": {
    "v": { "const": 1 },
    "id": { "$ref": "#/$defs/kebab" },
    "workflow": { "$ref": "#/$defs/kebab" },
    "subject": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "tone": { "type": "string", "minLength": 1 },
    "style_refs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "key_points": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "avoid": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "format": { "$ref": "#/$defs/kebab" },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/bibleBeat" }
    }
  },
  "$defs": {
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "bibleBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "title", "brief", "narration"],
      "properties": {
        "id": { "$ref": "#/$defs/kebab" },
        "role": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "brief": { "type": "string" },
        "narration": { "type": "string", "minLength": 1 }
      }
    }
  }
}
