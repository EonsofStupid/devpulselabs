{
  "$comment": "The 10th authored source. A ROLE is what a control MEANS; a treatment is how that meaning gets painted. Widgets bind to ROLES and never to treatments — that indirection is what makes the whole app re-dressable from data, and it is what stops 'neubrutalist' being written into a widget helper. Per-surface, with per-role fallback to `default` (the same M2 rule the matrix uses), so a surface states only what it CHANGES. A role may pin its own `tone`: danger is coral on every surface, because 'are you sure you want to delete this' must not turn lime just because the hub's tone is lime.",
  "default": {
    "chrome": {
      "trait": "vibron"
    },
    "hero": {
      "trait": "neubrutalist"
    },
    "quiet": {
      "trait": "claymorphic"
    },
    "danger": {
      "trait": "neubrutalist",
      "tone": "coral"
    }
  },
  "surfaces": {
    "wiredfront": {
      "chrome": {
        "coordinate": {
          "ancestor": "brutalist",
          "structure": "massive",
          "material": "plate",
          "atmosphere": "hard-cast"
        }
      }
    },
    "workbench": {
      "chrome": {
        "trait": "claymorphic"
      }
    },
    "viziwiz": {
      "chrome": {
        "trait": "vibron"
      }
    },
    "chat": {
      "colors": {
        "$comment": "Chat's COLOR ROLES: what each painted plane of the chat window MEANS, bound to a step of the hue pool (plus an optional alpha). The window names a role; which colour answers is this data. Every ref is checked at build time against hues.json.",
        "panel": {
          "backplate": { "hue": "abyss", "step": 975 },
          "glow-low": { "hue": "abyss", "step": 600, "alpha": 190 },
          "glow-high": { "hue": "abyss", "step": 950, "alpha": 190 },
          "ember": { "hue": "orange", "step": 500 },
          "strip": { "hue": "abyss", "step": 900 },
          "well": { "hue": "abyss", "step": 950 },
          "inset": { "hue": "abyss", "step": 950 },
          "raised": { "hue": "abyss", "step": 800 },
          "card": { "hue": "abyss", "step": 700 },
          "overlay": { "hue": "abyss", "step": 600 },
          "mark": { "hue": "abyss", "step": 700 },
          "edge": { "hue": "abyss", "step": 300 }
        },
        "rail": {
          "fill": { "hue": "abyss", "step": 900 },
          "header": { "hue": "abyss", "step": 800 },
          "avatar": { "hue": "abyss", "step": 500 },
          "selected": { "hue": "abyss", "step": 400 },
          "selected-edge": { "hue": "abyss", "step": 200 },
          "mark": { "hue": "abyss", "step": 800 }
        },
        "tab": {
          "idle": { "hue": "abyss", "step": 950 },
          "hover": { "hue": "abyss", "step": 700 },
          "selected": { "hue": "abyss", "step": 600 },
          "selected-edge": { "hue": "abyss", "step": 200 }
        },
        "chip": {
          "idle": { "hue": "abyss", "step": 800 },
          "on": { "hue": "abyss", "step": 400 },
          "on-edge": { "hue": "abyss", "step": 200 }
        },
        "bubble": {
          "fill": { "hue": "abyss", "step": 800, "alpha": 224 },
          "avatar": { "hue": "abyss", "step": 600 },
          "notice": { "hue": "abyss", "step": 700 }
        },
        "composer": {
          "fill": { "hue": "abyss", "step": 900 },
          "popup": { "hue": "abyss", "step": 800 }
        }
      }
    }
  }
}
