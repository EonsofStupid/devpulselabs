		"achromatic": {
			"$description": "Greyscale and absolutes. `void` is the deep app-background family — ultra-low chroma with a cool hue whisper; its dark end + base anchor are pinned so surfaces read cool, never dead grey.",
			"hues": [
				{ "id": "neutral", "hue": 0, "chroma": 0, "curve": "neutral", "chromaCurve": "flat", "description": "Pure greyscale — no hue, no chroma." },
				{
					"id": "void",
					"hue": 220,
					"chroma": 0.01,
					"curve": "neutral",
					"chromaCurve": "flat",
					"description": "Ultra-low-chroma dark scale — deepest app backgrounds and void surfaces.",
					"overrides": { "900": { "l": 0.19, "c": 0.01, "h": 220 }, "950": { "l": 0.12, "c": 0.01, "h": 220 }, "975": { "l": 0.1, "c": 0.01, "h": 220 } },
					"anchors": {
						"base": { "lightness": 0.08, "chroma": 0.01, "hue": 220, "description": "Void base — the deepest app-background anchor. Below the ramp floor by design; authored, not generated." }
					}
				},
				{ "id": "white", "kind": "single", "components": [1, 0, 0], "description": "Absolute white — oklch(1 0 0)." },
				{ "id": "black", "kind": "single", "components": [0, 0, 0], "description": "Absolute black — oklch(0 0 0). Exempt from the L-floor." }
