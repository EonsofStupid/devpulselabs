  "atmospheres": [
    {
      "id": "none",
      "label": "None",
      "blurb": "No shadow, no glow. Anti-atmospheric."
    },
    {
      "id": "hard-cast",
      "label": "Hard cast",
      "blurb": "One hard offset shadow, cast down-right, zero blur — a shape, never a glow. No halo: that is `lit-cast`. Carries the interaction convention — hover lifts the cast and strengthens the ink; ACTIVE washes the fill in the surface tone, lights the edge to it, and sinks onto the shadow, so exactly ONE control reads as live.",
      "shadows": [
        {
          "offset": [
            3,
            3
          ],
          "blur": 0,
          "spread": 0,
          "color": {
            "black": true,
            "alpha": 230
          }
        }
      ],
      "hover": {
        "shadows": [
          {
            "offset": [
              4,
              4
            ],
            "blur": 0,
            "spread": 0,
            "color": {
              "black": true,
              "alpha": 235
            }
