# Line-ending law: sources are LF everywhere (rustfmt enforces; git must not fight it).
* text=auto eol=lf
*.png binary
*.jpg binary
*.mp4 binary
*.ttf binary
*.webp binary
*.avif binary
Cargo.zip filter=lfs diff=lfs merge=lfs -text
# Captured tool output, kept byte-for-byte (ffmpeg on Windows writes CRLF):
# a parser test is only honest against the bytes the tool really emits.
crates/engine-capture/tests/fixtures/** -text
